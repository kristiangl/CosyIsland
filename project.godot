; Engine configuration file.
; Hand-maintained: keep it tidy, the editor will reformat it if opened.

config_version=5

[application]

config/name="Cosy Island"
config/description="A cosy island life game focused on crafting and decorating."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
Game="*res://scripts/autoload/game.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Recipes="*res://scripts/autoload/recipes.gd"
Icons="*res://scripts/autoload/icons.gd"
Prompts="*res://scripts/autoload/prompts.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Story="*res://scripts/autoload/story.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.9, 1)

[shader_globals]

curve_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
curve_amount={
"type": "float",
"value": 0.004
}
cel_lit={
"type": "vec3",
"value": Vector3(1, 0.99, 0.96)
}
cel_shadow={
"type": "vec3",
"value": Vector3(0.73, 0.7, 0.89)
}
wind_strength={
"type": "float",
"value": 1.0
}
