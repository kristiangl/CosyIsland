; Engine configuration file.
; Hand-maintained: keep it tidy, the editor will reformat it if opened.

config_version=5

[application]

config/name="Cosy Island"
config/description="A cosy island life game focused on crafting and decorating."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.984, 0.953, 0.863, 1)
boot_splash/image="res://assets/title/boot_splash.png"
boot_splash/fullsize=false

[autoload]

Events="*res://scripts/autoload/events.gd"
Game="*res://scripts/autoload/game.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Recipes="*res://scripts/autoload/recipes.gd"
Icons="*res://scripts/autoload/icons.gd"
Prompts="*res://scripts/autoload/prompts.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Story="*res://scripts/autoload/story.gd"
Effects="*res://scripts/autoload/effects.gd"
Journal="*res://scripts/autoload/journal.gd"
Music="*res://scripts/autoload/music.gd"
Weather="*res://scripts/autoload/weather.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
; Lighter in a browser (school laptops and tablets).
anti_aliasing/quality/msaa_3d.web=1
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
environment/defaults/default_clear_color=Color(0.55, 0.78, 0.9, 1)

[shader_globals]

curve_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
curve_amount={
"type": "float",
"value": 0.004
}
cel_lit={
"type": "vec3",
"value": Vector3(1, 0.99, 0.96)
}
cel_shadow={
"type": "vec3",
"value": Vector3(0.73, 0.7, 0.89)
}
night={
"type": "float",
"value": 0.0
}
night_glow={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 1.0
}
cloud_cover={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
foliage={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
grass_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
